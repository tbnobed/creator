# Copy this file to .env beside docker-compose.yml before starting OBTV.
# Do not commit the resulting .env file.

# Loopback ports exposed to Nginx Proxy Manager. Configure NPM to route the
# public domain root to WEB_PORT and /api (including /api/media) to API_PORT.
WEB_PORT=8080
API_PORT=5000

# PostgreSQL credentials. Use a URL-safe password (letters, numbers, "-", "_",
# and "."), because it is interpolated into DATABASE_URL for the API container.
POSTGRES_DB=obtv
POSTGRES_USER=obtv
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Optional API logging level: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Comma-separated external ComfyUI hostnames/IPs allowed by the API. The API
# rejects targets not listed here. Do not include scheme, path, or port.
# Example: COMFY_ALLOWED_HOSTS=comfy.example.com,203.0.113.10
COMFY_ALLOWED_HOSTS=

# Optional browser origin for a separately hosted frontend. Leave blank when
# NPM presents the UI and /api from one same-origin public domain.
CORS_ORIGIN=