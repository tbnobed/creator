# Copy this file to .env beside docker-compose.yml before starting OBTV.
# Do not commit the resulting .env file.

# Loopback ports exposed to Nginx Proxy Manager. Configure NPM to route the
# public domain root to WEB_PORT and /api (including /api/media) to API_PORT.
# Set WEB_BIND_ADDRESS=0.0.0.0 only when you need direct LAN access to the web
# UI, such as http://192.168.x.x:8080. Keep API_PORT loopback-only.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
API_PORT=5000

# PostgreSQL credentials. Use a URL-safe password (letters, numbers, "-", "_",
# and "."), because it is interpolated into DATABASE_URL for the API container.
POSTGRES_DB=obtv
POSTGRES_USER=obtv
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Optional API logging level: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Comma-separated external ComfyUI hostnames/IPs allowed by the API. The API
# rejects targets not listed here. Do not include scheme, path, or port.
# Example: COMFY_ALLOWED_HOSTS=comfy.example.com,203.0.113.10
COMFY_ALLOWED_HOSTS=

# Hardware-aware MiniMax H3 R2V seed. On a fresh database, the API creates
# the A100 INT8 ConvRot workflow and the Blackwell NVFP4 workflow automatically.
# Set each API/WS pair to seed that worker; leave both values blank to skip it.
# Each hostname must also appear in COMFY_ALLOWED_HOSTS above.
OBTV_SEED_A100_NAME=PN A100
OBTV_SEED_A100_API_URL=
OBTV_SEED_A100_WEBSOCKET_URL=
OBTV_SEED_A100_ENABLED=true
OBTV_SEED_A100_PRIORITY=5
OBTV_SEED_A100_MAX_CONCURRENT_JOBS=

OBTV_SEED_BLACKWELL_NAME=GB10_Asus
OBTV_SEED_BLACKWELL_API_URL=
OBTV_SEED_BLACKWELL_WEBSOCKET_URL=
OBTV_SEED_BLACKWELL_ENABLED=true
OBTV_SEED_BLACKWELL_PRIORITY=10
OBTV_SEED_BLACKWELL_MAX_CONCURRENT_JOBS=

# Optional browser origin for a separately hosted frontend. Leave blank when
# NPM presents the UI and /api from one same-origin public domain.
CORS_ORIGIN=