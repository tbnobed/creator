modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://create1.obtv.io"
SENDGRID_FROM_EMAIL = "alerts@obedtv.com"

[userenv.development]
STORY_AI_BASE_URL = "http://76.219.194.165:11434"
STORY_AI_COMFY_BASE_URL = "http://76.219.194.165:8188"
STORY_AI_MODEL = "qwen3.8:27b-q8_0"
